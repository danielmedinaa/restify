# Configuración COMÚN a dev, pre y pro. En el servidor: /srv/restify/config.env  (nunca al repositorio)
# desplegar.sh genera solo los secretos de cada ambiente.

# Tu dominio, sin www ni https. pro = DOMINIO, pre = pre.DOMINIO, dev = dev.DOMINIO
DOMINIO=turestify.com

# Correo para avisos de Let's Encrypt
ACME_EMAIL=tucorreo@gmail.com

# Token de Cloudflare con permiso "Zone > DNS > Edit" solo sobre tu dominio (para los certificados comodín)
CLOUDFLARE_API_TOKEN=

# Contacto que muestra la landing
WHATSAPP_NUMERO=584120000000
CONTACTO_EMAIL=hola@turestify.com
INSTAGRAM=turestify

# Zona horaria de las instancias de los clientes
ZONA_HORARIA_INSTANCIAS=America/Caracas

# --- Opcionales ---------------------------------------------------------------------------------------------
# Solo estas IPs o rangos (separados por espacio) podrán abrir el panel de administración. Vacío = sin restricción.
# Ojo con IPs dinámicas: si cambia la tuya, quedarás fuera hasta corregirlo (por SSH). Ej: 190.1.2.3/32
PANEL_IPS_PERMITIDAS=

# Avisos de la vigilancia (disco, memoria, contenedores caídos, páginas, certificados) por Telegram.
# Crea un bot con @BotFather (te da el token) y escríbele un mensaje; tu chat id sale en
# https://api.telegram.org/bot<TOKEN>/getUpdates   Vacío = los avisos solo quedan en el log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
