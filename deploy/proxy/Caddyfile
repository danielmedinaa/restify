# Proxy ÚNICO del servidor para los 3 ambientes. Variables: DOMINIO, ACME_EMAIL, CLOUDFLARE_API_TOKEN
#   pro: turestify.com        panel.turestify.com        <cliente>.turestify.com
#   pre: pre.turestify.com    panel.pre.turestify.com    <cliente>.pre.turestify.com
#   dev: dev.turestify.com    panel.dev.turestify.com    <cliente>.dev.turestify.com
# Se usan nombres de contenedor completos (restify-<entorno>-...): un alias como "panel" existe en los 3 ambientes.
{
	email {$ACME_EMAIL}
	admin off
	# El plugin de límites no tiene lugar fijo: va antes de cualquier handle/proxy
	order rate_limit before handle
}

# Límites por IP (Caddy ve la IP real: el DNS es "solo DNS", sin proxy delante). Al pasarse responde 429.
# Son una primera barrera: las apps además tienen su propio bloqueo por intentos fallidos.
(limites) {
	rate_limit {
		# Navegación normal de un local (un WebSocket cuenta una vez al abrirse)
		zone general {
			key {remote_host}
			events 600
			window 1m
		}
		# Contraseñas y códigos 2FA: panel (/login, /login/2fa) y sistema de cada cliente (/bff/auth/login)
		zone autenticacion {
			match {
				method POST
				path /login /login/* /bff/auth/login
			}
			key {remote_host}
			events 20
			window 1m
		}
		# Formulario de contacto de la landing
		zone formularios {
			match {
				method POST
				path /contacto
			}
			key {remote_host}
			events 5
			window 1m
		}
	}
}

(cabeceras) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(web) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# El DNS interno de Docker a veces no resuelve los nameservers al comprobar el desafío: se usan resolvers públicos
		resolvers 1.1.1.1 8.8.8.8
	}
	encode zstd gzip
	import cabeceras
	import limites
}

# {args[0]} = prefijo del ambiente (restify-pro, restify-pre, restify-dev)
(clientes) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# El DNS interno de Docker a veces no resuelve los nameservers al comprobar el desafío: se usan resolvers públicos
		resolvers 1.1.1.1 8.8.8.8
	}
	encode zstd gzip
	import cabeceras
	import limites

	@inst header_regexp sub Host ^([a-z0-9-]+)\.
	handle @inst {
		# Tiempo real directo a la API; todo lo demás (incluidas las fotos y /bff) al front
		handle /ws/* {
			reverse_proxy {args[0]}-{re.sub.1}-api-1:8000
		}
		handle {
			reverse_proxy {args[0]}-{re.sub.1}-front-1:3000
		}
	}
	handle {
		respond "RESTIFY · instancia no encontrada" 404
	}

	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width"><title>RESTIFY</title><body style="background:#1a1819;color:#fff;font:16px system-ui;display:grid;place-items:center;min-height:100vh;margin:0;text-align:center"><div><h1>Servicio no disponible</h1><p style="opacity:.7">Esta cuenta está pausada, en mantenimiento o aún se está creando.<br>Si crees que es un error, contacta a RESTIFY.</p></div>` 503
	}
}

# ---------------------------------------------------------------- PRODUCCIÓN
{$DOMINIO}, www.{$DOMINIO} {
	import web
	reverse_proxy restify-pro-landing-1:8000
}

panel.{$DOMINIO} {
	import web
	reverse_proxy restify-pro-panel-1:8000
}

*.{$DOMINIO} {
	import clientes restify-pro
}

# ---------------------------------------------------------------- PRE
pre.{$DOMINIO} {
	import web
	reverse_proxy restify-pre-landing-1:8000
}

panel.pre.{$DOMINIO} {
	import web
	reverse_proxy restify-pre-panel-1:8000
}

*.pre.{$DOMINIO} {
	import clientes restify-pre
}

# ---------------------------------------------------------------- DEV
dev.{$DOMINIO} {
	import web
	reverse_proxy restify-dev-landing-1:8000
}

panel.dev.{$DOMINIO} {
	import web
	reverse_proxy restify-dev-panel-1:8000
}

*.dev.{$DOMINIO} {
	import clientes restify-dev
}
