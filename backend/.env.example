# Copia este archivo a .env y cambia TODOS los secretos.
# Genera secretos con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development          # development | production
API_PORT=8000

POSTGRES_DB=restify
POSTGRES_USER=restify
POSTGRES_PASSWORD=cambia-esto

REDIS_PASSWORD=cambia-esto

# Mínimo 32 caracteres aleatorios
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Listas en formato JSON
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","api"]

# URLs del frontend usadas para armar los QR y los links de seguimiento
PUBLIC_MENU_BASE_URL=http://localhost:3000/mesa
PUBLIC_TRACKING_BASE_URL=http://localhost:3000/pedido

# Zona horaria para los filtros de ventas por día/mes/año
TIMEZONE=America/Caracas

# IGTF sobre pagos en divisas (%), para el documento de facturación
IGTF_PORCENTAJE=3

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# IPs del proxy inverso (nginx/traefik) en las que se confía para X-Forwarded-For.
# Déjalo en 127.0.0.1 si no hay proxy; NUNCA uses * si el puerto está expuesto a internet.
# El front (BFF de Next) llama a la API desde la red de Docker: incluye esa subred para que el
# rate limit sea por cliente y no global. Mírala con: docker network inspect restify_default
FORWARDED_ALLOW_IPS=127.0.0.1
WEB_CONCURRENCY=2

# Pedidos por QR sin confirmar se cancelan solos tras estos minutos (0 = nunca)
QR_VENCIMIENTO_MIN=15

# Consulta opcional de cédulas (https://cedula.com.ve, servicio de terceros, no oficial).
# Mejor cargarla desde el panel (Administración → Configuración): ahí el token queda cifrado.
# Vacío = desactivada. El token solo vive en el servidor.
CEDULA_API_APP_ID=
CEDULA_API_TOKEN=

# Suscripción y límites del plan, controlados desde el panel de RESTIFY (carpeta panel/).
# Vacío = sin restricciones (desarrollo). El token se muestra UNA vez al crear la instancia en el panel.
# En local con Docker (misma red restify-net): http://panel:8000/api/v1/estado
PANEL_URL=
PANEL_TOKEN=
