# Copia a .env y completa. Secretos: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PANEL_ENV=development
PANEL_PORT=8030

# Base de datos del panel (Postgres en Docker; la URL completa la arma docker-compose)
POSTGRES_DB=panel
POSTGRES_USER=panel
POSTGRES_PASSWORD=cambia-esto

# Firma la cookie de sesión. Obligatoria en producción.
SECRET_KEY=cambia-esto
# Cifra los secretos 2FA guardados en la base. Distinta de SECRET_KEY. Si la pierdes, todos
# tendrán que volver a configurar el 2FA. Obligatoria en producción.
CLAVE_CIFRADO=cambia-esto-tambien

# Dominio bajo el que viven las instancias: <cliente>.<DOMINIO_BASE>
# En local, *.localhost resuelve a 127.0.0.1 sin tocar /etc/hosts.
DOMINIO_BASE=restify.localhost
# Esquema y puerto con los que se arma la URL de cada instancia (en producción: https y vacío)
INSTANCIA_ESQUEMA=http
INSTANCIA_PUERTO=8088

# Detrás de un proxy (nginx/Caddy): cuántos proxies hay delante e IPs en las que confía gunicorn
PROXY_SALTOS=0
FORWARDED_ALLOW_IPS=127.0.0.1

# Sesión del administrador: minutos sin actividad y duración máxima absoluta
SESION_INACTIVIDAD_MIN=20
SESION_MAXIMA_HORAS=8

# Agente de instancias (proceso aparte con acceso a Docker; ver ../infra/README.md)
AGENTE_SECRETO=genera-uno-de-48-caracteres
AGENTE_SOCKET=/run/agente/agente.sock
PANEL_URL_INTERNA=http://panel:8000
ZONA_HORARIA_INSTANCIAS=America/Caracas

# Infra: "agente" crea instancias reales con Docker; "simulado" solo escribe los archivos de cada instancia en data/instancias (sin ejecutar nada)
APROVISIONADOR=agente

# URL pública del panel, la que usan las instancias para consultar su estado
PANEL_URL=http://localhost:8030
