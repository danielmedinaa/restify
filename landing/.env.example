# Copia a .env y completa.  Secreto: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LANDING_ENV=production
SECRET_KEY=cambia-esto
LANDING_PORT=8020

# Contacto que aparece en la página
WHATSAPP_NUMERO=584120000000
CONTACTO_EMAIL=hola@restify.app
INSTAGRAM=restify.app
# Link a la demo de la app (opcional; si está vacío no se muestra el botón)
DEMO_URL=

# Detrás de un proxy (nginx/Caddy): cuántos proxies hay delante e IPs en las que confía gunicorn
PROXY_SALTOS=0
FORWARDED_ALLOW_IPS=127.0.0.1

# Máximo de solicitudes de demo por IP en la ventana (minutos)
LEADS_MAX_POR_IP=3
LEADS_VENTANA_MIN=30

# Chat de Tawk.to (asistente IA). Vacío = no se carga.
# Salen del código de instalación: https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
