# ---- Servidor (nunca llegan al navegador) ----
# URL de la API vista desde el servidor de Next. En Docker: http://api:8000
API_URL=http://localhost:8010

# Una key por app, creadas con: docker compose exec api python -m app.cli crear-api-key --nombre "..."
PANEL_API_KEY=
PUBLIC_API_KEY=
# Opcional: si se define, la pantalla de cocina usa esta key en vez de la del panel
KITCHEN_API_KEY=

# 32+ caracteres aleatorios para cifrar la cookie de sesión:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Pon false SOLO para probar desde otro dispositivo por http en la red local
# (las cookies Secure no se guardan fuera de https o localhost)
COOKIE_SECURE=true

# Solo desarrollo: IPs desde las que se abre el dev server (para probar en el teléfono)
DEV_ALLOWED_ORIGINS=

# ---- Navegador ----
# El WebSocket va directo al backend (el BFF no lo proxea)
NEXT_PUBLIC_WS_URL=ws://localhost:8010

# Chat de ayuda en el panel (Tawk.to con asistente IA). Vacío = no se carga.
# Salen del código de instalación: https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
# Se incrustan al compilar: en Docker, reconstruye la imagen si cambian.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
